# ==============================================================================
# MYXSI BACKEND - ENVIRONMENT VARIABLES TEMPLATE (CLOUDFLARE WORKERS & D1)
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo a `.env` o añade estas variables en tu Cloudflare Dashboard:
#    Workers & Pages -> Settings -> Variables -> Environment Variables.
# 2. NUNCA subas claves reales ni archivos .env a repositorios públicos de GitHub.
# ==============================================================================

# Claves de Groq AI (separadas por comas para rotación automática y tolerancia a fallos)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_KEYS=gsk_tu_clave_aqui_1,gsk_tu_clave_aqui_2

# Token secreto de administración para blindar rutas críticas y migraciones de BD
ADMIN_SECRET=coloca_aqui_un_secreto_aleatorio_muy_largo_y_seguro

# Orígenes permitidos para CORS (separados por comas)
ALLOWED_ORIGINS=https://myxsi.com,https://www.myxsi.com,http://localhost:8000,http://localhost:8787

# URL opcional de Google Apps Script (solo para fallback si no se usa Cloudflare D1)
APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbz_TU_SCRIPT_ID/exec

# Modo Debug (colocar 'false' en producción para ocultar detalles de errores)
DEBUG=false
